#include <iostream>
using namespace std;

int main() {
    int x = 5, y = 3;
    cout << x + y * 2 << ' ' << (x + y) * 2 << '\n';
    int z = x++ + ++y;
    cout << z << ' ' << x << ' ' << y << '\n';
    cout << (x > y ? x : y) << ' ' << x % y << ' ' << (x % y) * 2 << '\n';
    cout << 10 / 3 << ' ' << 10 % 3 << ' ' << -10 / 3 << ' ' << -10 % 3 << '\n';
    int total = 0;
    for (int i = 0; i < 12; i += 3) total += i;
    cout << total << '\n';
    return 0;
}
